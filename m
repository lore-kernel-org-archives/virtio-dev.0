                            "%s attempting to join bypass dev when %s already present\n",
                            child_netdev-&gt;name, backup ? "backup" : "active");
                return NOTIFY_DONE;
        }

        /* Avoid non pci devices as active netdev */
        if (!backup &amp;&amp; (!child_netdev-&gt;dev.parent ||
                        !dev_is_pci(child_netdev-&gt;dev.parent)))
                return NOTIFY_DONE;

