	vbi = netdev_priv(dev);
        backup = (child_netdev-&gt;dev.parent == dev-&gt;dev.parent);
        if (backup ? rtnl_dereference(vbi-&gt;backup_netdev) :
                        rtnl_dereference(vbi-&gt;active_netdev)) {
